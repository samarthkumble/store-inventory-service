[run]
source = app, scripts, replenishment
# Also measure which if/else branches ran, not just which lines.
branch = True
# bench.py and demo_events.py are manual tools that need a running stack,
# not product code, so they are not part of the coverage target.
omit = scripts/bench.py, scripts/demo_events.py

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
